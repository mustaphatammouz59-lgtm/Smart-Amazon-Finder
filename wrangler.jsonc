{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Internal project identifier. The public brand is decided at gate
  // D-01 (Stage 11); renaming the Worker then is a config change only.
  "name": "smart-amazon-finder",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "vars": {
    // PLACEHOLDER until the real domain exists (Stage 11). Keep in sync
    // with app/config/site.ts → siteUrl.
    "SITE_URL": "https://smart-amazon-finder.mustaphatammouz59.workers.dev"
  },
  // Secrets are NEVER stored in this file. Set them per environment with
  // `wrangler secret put <NAME>` (see README → Secrets).
  //
  // Bindings below use placeholder IDs. Before the first real deploy,
  // provision the resources and replace the IDs:
  //   wrangler d1 create smart-amazon-finder-db
  //   wrangler kv namespace create APP_KV
  //   wrangler r2 bucket create smart-amazon-finder-media
  //   wrangler queues create smart-amazon-finder-jobs
  // Local development (wrangler dev / react-router dev) emulates all of
  // them automatically with these names.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smart-amazon-finder-db",
      "database_id": "f2bfdc9b-c194-411c-a320-718bb6386635",
      "migrations_dir": "./migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "APP_KV",
      "id": "f07a0362a1774446ab829a61fdd95d57"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "smart-amazon-finder-media"
    }
  ],
  // Native Workers Rate Limiting bindings (Stage 03.2). namespace_id is
  // a self-chosen identifier; the platform provisions the binding at
  // deploy — no separate resource creation is required. Budgets follow
  // API-ARCHITECTURE.md §2 (search 60/min/IP, admin write 120/min/admin).
  // NOTE: counters are per Cloudflare location, not a strict global
  // quota — see app/lib/rate-limit.ts for the honest limitation note.
  "ratelimits": [
    { "name": "SEARCH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "ADMIN_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "smart-amazon-finder-jobs" }
    ],
    // Consumer + dead-letter configuration (Stage 03, API-ARCHITECTURE.md
    // §7). Takes effect on the next approved deployment; the DLQ itself is
    // created with `wrangler queues create smart-amazon-finder-dlq` at
    // that time (owner-side step, like the original queue provisioning).
    "consumers": [
      {
        "queue": "smart-amazon-finder-jobs",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "smart-amazon-finder-dlq"
      }
    ]
  }
}
